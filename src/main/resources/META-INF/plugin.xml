<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.kimuth.jetbrainsmakotemplateplugin</id>
    <name>Mako Template Support</name>
    <vendor>kimuth</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.MakoFileType"
            fieldName="INSTANCE"
            language="Mako Template"
            extensions="mako;mak"
            patterns="*.html.mako"/>
        <lang.parserDefinition language="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.MakoParserDefinition"/>

        <!-- Phase 4: Syntax Highlighting -->
        <lang.syntaxHighlighterFactory language="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.highlighting.MakoSyntaxHighlighterFactory"/>
        <colorSettingsPage
            implementation="com.github.kimuth.jetbrainsmakotemplateplugin.lang.highlighting.MakoColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/MakoDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/MakoDarcula.xml"/>

        <!-- Phase 4: Tag Pair Matching -->
        <lang.braceMatcher language="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.highlighting.MakoPairedBraceMatcher"/>

        <!-- Phase 4: Comment Toggling -->
        <lang.commenter language="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.editing.MakoCommenter"/>

        <!-- Phase 5: Code Folding -->
        <lang.foldingBuilder language="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.folding.MakoFoldingBuilder"/>

        <!-- Phase 5: Structure View -->
        <lang.psiStructureViewFactory language="Mako Template"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.structure.MakoStructureViewFactory"/>

        <!-- Phase 6: Python Language Injection -->
        <multiHostInjector
            implementation="com.github.kimuth.jetbrainsmakotemplateplugin.lang.injection.MakoPythonInjector"/>

        <!-- Phase 7: Completion -->
        <!-- language="any" so the contributor fires for all element positions in Mako files,
             including TEMPLATE_TEXT positions where the caret is after "<%". The contributor's
             internal language guard (file.language.id check) ensures it only produces completions
             for Mako Template files. Using language="Mako Template" causes the platform to skip
             the contributor for elements in template data language positions. -->
        <completion.contributor
            language="any"
            implementationClass="com.github.kimuth.jetbrainsmakotemplateplugin.lang.completion.MakoCompletionContributor"/>
    </extensions>
</idea-plugin>
